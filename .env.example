# Stripe API keys (Stripe Dashboard -> Developers -> API keys).
# Use the test keys (sk_test_... / pk_test_...) until you are ready to sell.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Postgres connection string. docker-compose.yml and render.yaml set this for you.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Public https address of the site, e.g. https://www.example.com
# Needed so Stripe can send product/price updates to /api/stripe/webhook.
# Render sets this automatically; set it yourself when using a custom domain.
# PUBLIC_URL=
